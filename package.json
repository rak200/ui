{
  "name": "@rak200/ui",
  "version": "0.2.19",
  "description": "Host-agnostic custom-element UI components for the rak200 ecosystem",
  "license": "MIT",
  "author": "rak200 <rak.ricardo@windowslive.com>",
  "homepage": "https://github.com/rak200/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rak200/ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*.js": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/*.js",
    "./src/*.ts",
    "./dist/icons/*.js",
    "./src/icons/*.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "npm run build && publint --strict",
    "lint": "prettier --check .",
    "fix": "prettier --write . && eslint --fix .",
    "analyse": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "coverage": "coverage-floor",
    "scan": "rak200-scan",
    "mutation": "node tests/tooling/mutate-changed.mjs",
    "build": "tsc -p tsconfig.icons.json && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rak200/coding-standard-ts": "github:rak200/coding-standard-ts#0.4.7",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/web-components-vite": "^10.5.8",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.13.0",
    "storybook": "^10.5.8"
  }
}
