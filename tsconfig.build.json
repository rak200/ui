{
  "extends": "./tsconfig.json",
  "compilerOptions": { "outDir": "dist", "rootDir": "src" },
  // `include` is restated, not inherited: the base config also covers `tests/`, and a
  // build rooted at `src` errors on an input outside its rootDir.
  "include": ["src"],
  // Matches nothing now that tests live in `tests/`, and kept anyway: it asserts no rule,
  // it only fails safe if a test file is ever colocated by accident.
  // `src/icons` is excluded here and built by `tsconfig.icons.json` instead, which turns
  // the source maps off. Two thousand generated data modules carry 885 KiB of maps that
  // point at a `register()` call — nothing anybody will ever step through — and that was
  // half the weight of the published package.
  "exclude": ["src/**/*.test.ts", "src/icons"]
}
